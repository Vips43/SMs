{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "entrypoint": "api/index.js"
    },
    "client": {
      "root": "client",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/send-reminders",
      "schedule": "31 13 * * *"
    },
    {
      "path": "/api/cron/auto-checkout",
      "schedule": "57 13 * * *"
    }
  ]
}